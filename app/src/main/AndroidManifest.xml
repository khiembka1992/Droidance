<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Truy cập mạng (LLM API) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Dịch vụ chạy nền trước -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Bộ nhớ (đọc/ghi tệp Markdown) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Tự khởi động khi bật máy (khôi phục tác vụ định kỳ) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Báo thức chính xác (tác vụ định kỳ) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Quyền thông báo -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Danh bạ -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Tin nhắn SMS -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Lịch sử cuộc gọi -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Lịch -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Tệp phương tiện (quyền chi tiết Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- WiFi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ADB shell cấp quyền này sau khi ghép nối AIR lần đầu thành công, dùng để tự khôi phục gỡ lỗi không dây về sau. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Multicast mDNS (phát hiện dịch vụ ghép nối gỡ lỗi không dây ở chế độ AIR) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Truy vấn mọi ứng dụng đã cài (giới hạn hiển thị gói từ Android 11+, bắt buộc với ứng dụng tự động hóa) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Báo thức -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Rung -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Return the visible host task to input focus after a user taps its editor. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- Giữ màn hình sáng (chống tắt màn hình khi thực thi tác vụ) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Tự cập nhật ứng dụng (quyền cài ứng dụng không rõ nguồn gốc) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".DroidanceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Droidance"
        tools:targetApi="35">
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
        <service android:name=".agent.device.AgentTextInputMethodService"
            android:process=":input_driver"
            android:label="@string/agent_text_input_method_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/agent_text_input_method" />
        </service>
        <receiver android:name=".agent.device.RuntimeDriverBinderReceiver" android:process=":input_driver"
            android:permission="android.permission.DUMP" android:exported="true" />
        <service android:name="com.droidance.core.device.program.ProgramWorkerService"
            android:process=":program_worker" android:isolatedProcess="true" android:exported="false" />


        <activity android:name=".WorkspaceDeliverableActivity" android:exported="false" />

        <activity
            android:name=".agent.device.VirtualSpaceViewerActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.virtualspace"
            android:theme="@style/Theme.Droidance" />

        <activity
            android:name=".agent.device.InputFocusHandoffActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".agent.device.VirtualSpaceProbeActivity"
            android:process=":input_driver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Màn hình chính -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|fontScale|density|smallestScreenSize"
            android:theme="@style/Theme.Droidance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dịch vụ theo dõi thông báo -->
        <service
            android:name=".automation.NotificationWatcher"
            android:process=":input_driver"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Dịch vụ thực thi tác vụ chạy nền trước -->
        <service
            android:name=".daemon.TaskExecutionService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Dịch vụ giám sát định kỳ: khôi phục dịch vụ thường trú và kết nối thiết bị theo chu kỳ -->
        <service
            android:name=".daemon.KeepAliveJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Bộ nhận broadcast khởi động máy -->
        <receiver
            android:name=".daemon.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".automation.AutomationAlarmReceiver"
            android:exported="false" />

        <!-- Bộ nhận mã ghép nối không dây ở chế độ AIR -->
        <receiver
            android:name="com.droidance.core.device.air.AirModePairingReceiver"
            android:exported="false" />

        <!-- Bộ nhận binder Sidecar: tiến trình app_process server chạy dưới quyền shell đẩy binder qua broadcast (bỏ qua ServiceManager) -->
        <receiver
            android:name="com.droidance.core.device.agent.device.SidecarBinderReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.droidance.action.SIDECAR_BINDER_READY" />
            </intent-filter>
        </receiver>

        <!-- Provider chia sẻ tệp -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Initialize WorkManager on demand through Configuration.Provider. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
